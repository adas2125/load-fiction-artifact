+
+func writeWorkersOutput(path string, initial, max, used uint64) error {
+	out, err := file(path, true)
+	if err != nil {
+		return err
+	}
+	defer out.Close()
+
+	return json.NewEncoder(out).Encode(workersOutput{
+		InitialWorkers: initial,
+		MaxWorkers:     max,
+		WorkersUsed:    used,
+	})
+}
+
+func startWorkerTimelineOutput(path string, atk *vegeta.Attacker, interval time.Duration) (func() error, error) {
+	out, err := file(path, true)
+	if err != nil {
+		return nil, err
+	}
+
+	writer := bufio.NewWriter(out)
+	start := time.Now()
+	writeSample := func(now time.Time) error {
+		if _, err := fmt.Fprintf(writer, "%.9f,%d,%d\n", float64(now.UnixNano())/1e9, now.Sub(start).Milliseconds(), atk.WorkersUsed()); err != nil {
+			return err
+		}
+		return writer.Flush()
+	}
+
+	if _, err := writer.WriteString("timestamp_unix,elapsed_ms,workers_used\n"); err != nil {
+		out.Close()
+		return nil, err
+	}
+	if err := writeSample(start); err != nil {
+		out.Close()
+		return nil, err
+	}
+
+	stop := make(chan struct{})
+	done := make(chan error, 1)
+	go func() {
+		ticker := time.NewTicker(interval)
+		defer ticker.Stop()
+
+		for {
+			select {
+			case now := <-ticker.C:
+				if err := writeSample(now); err != nil {
+					done <- err
+					return
+				}
+			case <-stop:
+				err := writeSample(time.Now())
+				if flushErr := writer.Flush(); err == nil {
+					err = flushErr
+				}
+				if closeErr := out.Close(); err == nil {
+					err = closeErr
+				}
+				done <- err
+				return
+			}
+		}
+	}()
+
+	return func() error {
+		close(stop)
+		return <-done
+	}, nil
 }
 
